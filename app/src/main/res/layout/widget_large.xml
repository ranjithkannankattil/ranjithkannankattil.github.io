<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="14dp">
        <FrameLayout android:id="@+id/w_open" android:layout_width="64dp" android:layout_height="64dp">
            <ImageView android:id="@+id/w_artbg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_art" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_logo" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center"
                android:src="@drawable/ic_logo_mark" android:contentDescription="Open Radio Velvet" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="14dp">
            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RADIO VELVET" android:textSize="10sp" android:letterSpacing="0.2" android:fontFamily="@font/jost_medium" />
            <TextView android:id="@+id/w_station" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tap play to listen" android:textSize="17sp" android:maxLines="1" android:ellipsize="end"
                android:fontFamily="@font/jost_regular" />
            <TextView android:id="@+id/w_song" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/jost_regular" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:layout_marginTop="2dp">
                <ImageView android:id="@+id/w_prev" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
                    android:src="@drawable/ln_prev" android:contentDescription="Previous station" />
                <FrameLayout android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp">
                    <ImageView android:id="@+id/w_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/widget_ring" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/w_playicon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                        android:src="@drawable/ln_play" android:contentDescription="Play or pause" />
                </FrameLayout>
                <ImageView android:id="@+id/w_next" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
                    android:src="@drawable/ln_next" android:contentDescription="Next station" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
