rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in visitor can read and write only their own document: users/{their uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['favs', 'def', 'updated'])
        && request.resource.data.favs is list && request.resource.data.favs.size() <= 500
        && (!('def' in request.resource.data) || request.resource.data.def is string);
    }
    // Visitor counter: anyone may read the total or add exactly one; nothing else is stored.
    match /stats/site {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
      allow update: if request.resource.data.keys().hasOnly(['visits'])
        && request.resource.data.visits == resource.data.visits + 1;
    }
    // ---- Radio ratings and comments (see docs/superpowers/specs/2026-10-23-radio-ratings-share-design.md)
    // The approver is the site owner's Firebase account ID, filled in below once known. Empty = nobody.
    function ownerUid() { return 'oidT4ydQi7aRffo0v6qvf4mMNM72'; } // OWNER_UID
    function isOwner() { return request.auth != null && ownerUid() != '' && request.auth.uid == ownerUid(); }
    function signedAs(uid) { return request.auth != null && request.auth.uid == uid; }
    function goodStars(v) { return v is int && v >= 1 && v <= 5; }

    // One vote per browser per station. Every vote is written in a batch with limits/{uid},
    // and the previous limits/{uid}.last must be at least 12 s old.
    match /ratings/{key}/votes/{uid} {
      allow read: if true;
      allow create, update: if signedAs(uid)
        && request.resource.data.keys().hasOnly(['stars', 'ts'])
        && goodStars(request.resource.data.stars)
        && request.resource.data.ts == request.time
        && getAfter(/databases/$(database)/documents/limits/$(uid)).data.last == request.time
        && (!exists(/databases/$(database)/documents/limits/$(uid))
            || !('last' in get(/databases/$(database)/documents/limits/$(uid)).data)
            || get(/databases/$(database)/documents/limits/$(uid)).data.last < request.time - duration.value(12, 's'));
      allow delete: if isOwner();
    }
    // limits/{uid}: when this browser last rated (last) and last commented (lastComment).
    // Each field may only be set to the current time or left as it was; it can't be dropped.
    function stamp(f) {
      return (f in request.resource.data)
        ? (request.resource.data[f] == request.time
           || (resource != null && f in resource.data && request.resource.data[f] == resource.data[f]))
        : (resource == null || !(f in resource.data));
    }
    match /limits/{uid} {
      allow read: if signedAs(uid);
      allow create, update: if signedAs(uid)
        && request.resource.data.keys().hasOnly(['last', 'lastComment'])
        && stamp('last') && stamp('lastComment');
    }

    // Comments: public only once approved; the author and the owner can read them before that.
    function authorWrite(id) {
      let d = request.resource.data;
      return request.auth != null && d.uid == request.auth.uid
        && d.keys().hasOnly(['key', 'uid', 'stars', 'text', 'ts', 'status'])
        && d.keys().hasAll(['key', 'uid', 'stars', 'text', 'ts', 'status'])
        && d.key is string && d.key.matches('^[a-z0-9-]+~[^/~]{1,200}$') && id == d.key + '__' + d.uid
        && d.text is string && d.text.size() <= 300
        && goodStars(d.stars) && d.ts == request.time && d.status == 'waiting'
        // written in a batch with limits/{uid}.lastComment, at most one comment every 30 s
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.lastComment == request.time
        && (!exists(/databases/$(database)/documents/limits/$(request.auth.uid))
            || !('lastComment' in get(/databases/$(database)/documents/limits/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/limits/$(request.auth.uid)).data.lastComment < request.time - duration.value(30, 's'));
    }
    match /comments/{id} {
      allow get: if resource == null || resource.data.status == 'approved' || isOwner()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if resource.data.status == 'approved' || isOwner();
      allow create: if authorWrite(id);
      allow update: if (authorWrite(id) && resource.data.uid == request.auth.uid)
        || (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['approved', 'rejected']);
      allow delete: if isOwner() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
